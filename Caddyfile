{
#	admin off
	auto_https off
}
# caddy reload --config Caddyfile
:8080 {
	root * site
	encode zstd gzip

	redir   /old  /about.html 301
	rewrite /team /about.html

	header {
		?Cache-Control "public, max-age=300"
		X-Content-Type-Options nosniff
		-Server
	}

	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
		@500 expression {err.status_code} == 500
		handle @500 {
			rewrite * /500.html
			file_server
		}

		@bad expression {err.status_code} in [502, 503, 504]
		handle @bad {
			header Content-Type text/html
			respond `<h1>Сервис временно недоступен</h1><p>Код: {err.status_code}</p>` {err.status_code}
		}
	}

	handle /api/* {
		reverse_proxy localhost:3001
	}

	handle_path /v1/* {
		reverse_proxy localhost:3001
	}
	handle /old-prefix/* {
		uri strip_prefix /old-prefix
		reverse_proxy localhost:3001
	}

	handle_path /svc/* {
		reverse_proxy localhost:3001 {
			header_up X-Real-IP {remote_host}
			header_up -Cookie
			header_down -X-Backend
			header_down X-Served-By edge
		}
	}
	handle /ws {
		reverse_proxy localhost:3100
	}
	handle /events {
		rewrite * /api/events
		reverse_proxy localhost:3001 {
			flush_interval -1
		}
	}
	handle /down/* {
		reverse_proxy localhost:3999
	}

	handle {
		file_server
	}

	handle /test-500 {
		error 500
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	file_server
}
:8083 {
	root * site
	try_files {path} /index.html
	file_server
}